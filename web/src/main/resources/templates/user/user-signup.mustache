{{>layout/header}}
<div class="auth-shell">
    <section class="surface-card auth-card" aria-labelledby="signup-title">
        <div class="auth-brand"><i class="bi bi-person-plus" aria-hidden="true"></i><h1 id="signup-title" class="h3 fw-bold mt-2">회원가입</h1><p class="text-secondary mb-0">간단한 정보로 PookyBlog를 시작하세요.</p></div>
        <form id="signup-form" class="needs-validation" novalidate>
            <div class="mb-3"><label for="username" class="form-label fw-semibold">아이디 <span class="required-mark">*</span></label><input type="text" id="username" class="form-control" placeholder="로그인에 사용할 아이디" autocomplete="username" required><div id="valid_username" class="invalid-feedback">아이디를 입력해 주세요.</div></div>
            <div class="mb-3"><label for="password" class="form-label fw-semibold">비밀번호 <span class="required-mark">*</span></label><input type="password" id="password" class="form-control" placeholder="안전한 비밀번호를 입력하세요" autocomplete="new-password" required><div id="valid_password" class="invalid-feedback">비밀번호를 입력해 주세요.</div></div>
            <div class="mb-3"><label for="nickname" class="form-label fw-semibold">닉네임 <span class="required-mark">*</span></label><input type="text" id="nickname" class="form-control" placeholder="게시글에 표시할 이름" required><div id="valid_nickname" class="invalid-feedback">닉네임을 입력해 주세요.</div></div>
            <div class="mb-4"><label for="email" class="form-label fw-semibold">이메일 <span class="required-mark">*</span></label><input type="email" id="email" class="form-control" placeholder="name@example.com" autocomplete="email" required><div id="valid_email" class="invalid-feedback">올바른 이메일을 입력해 주세요.</div></div>
            <button type="button" id="btn-signup" class="btn btn-primary w-100" data-loading-text="가입 중...">회원가입</button>
        </form>
        <p class="text-center text-secondary mt-4 mb-0">이미 계정이 있으신가요? <a href="/auth/login" class="fw-semibold">로그인</a></p>
    </section>
</div>
{{>layout/footer}}
