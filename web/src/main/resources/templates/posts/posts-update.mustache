{{>layout/header}}
<div class="page-shell editor-shell">
    <div class="page-heading editor-heading"><a href="/posts/getPost/{{posts.id}}" class="back-link"><i class="bi bi-arrow-left" aria-hidden="true"></i>게시글로 돌아가기</a><h1>게시글 수정</h1><p>내용을 다듬고 변경 사항을 저장하세요.</p></div>
    <form id="post-form" class="surface-card content-form needs-validation" novalidate>
        <input type="hidden" id="id" value="{{posts.id}}">
        <div class="mb-4"><label for="title" class="form-label fw-semibold">제목 <span class="required-mark" aria-hidden="true">*</span></label><input type="text" class="form-control title-input" id="title" value="{{posts.title}}" maxlength="200" required><div class="invalid-feedback">제목을 입력해 주세요.</div></div>
        <div class="mb-4"><label for="content" class="form-label fw-semibold">내용 <span class="required-mark" aria-hidden="true">*</span></label><textarea rows="14" class="form-control content-input" id="content" required>{{posts.content}}</textarea><div class="invalid-feedback">내용을 입력해 주세요.</div></div>
        <div class="editor-actions"><a href="/posts/getPost/{{posts.id}}" class="btn btn-outline-secondary">취소</a><button type="submit" id="btn-update" class="btn btn-primary" data-loading-text="수정 중..."><i class="bi bi-check2 me-1" aria-hidden="true"></i>변경 사항 저장</button></div>
    </form>
</div>
{{>layout/footer}}
