{{>layout/header}}
<div class="page-shell">
    <div class="page-heading"><h1>게시글 수정</h1><p><strong>{{posts.writer}}</strong>님이 작성한 글을 수정합니다.</p></div>
    <form id="post-form" class="surface-card content-form needs-validation" novalidate>
        <input type="hidden" id="id" value="{{posts.id}}">
        <div class="mb-4"><label for="title" class="form-label fw-semibold">제목 <span class="required-mark" aria-hidden="true">*</span></label><input class="form-control" id="title" value="{{posts.title}}" maxlength="200" required><div class="invalid-feedback">제목을 입력해 주세요.</div></div>
        <div class="mb-4"><label for="content" class="form-label fw-semibold">내용 <span class="required-mark" aria-hidden="true">*</span></label><textarea rows="14" class="form-control" id="content" required>{{posts.content}}</textarea><div class="invalid-feedback">내용을 입력해 주세요.</div></div>
        <div class="d-flex justify-content-end gap-2"><a href="/posts/getPost/{{posts.id}}" class="btn btn-outline-secondary">취소</a><button type="button" id="btn-update" class="btn btn-primary" data-loading-text="수정 중..."><i class="bi bi-check2 me-1"></i>수정 완료</button></div>
    </form>
</div>
{{>layout/footer}}
