{{>layout/header}}
<div class="page-shell">
    <article class="surface-card post-article">
        <header class="post-article-header">
            <input type="hidden" id="id" value="{{posts.id}}">
            <h1 class="post-article-title">{{posts.title}}</h1>
            <div class="post-meta">
                <span><i class="bi bi-person me-1"></i>{{posts.writer}}</span>
                <span><i class="bi bi-calendar3 me-1"></i>{{posts.createdDate}}</span>
                <span><i class="bi bi-eye me-1"></i>조회 <strong id="view-count">{{viewCount}}</strong></span>
                <span><i class="bi bi-heart me-1"></i>좋아요 <strong id="like-count">{{likeCount}}</strong></span>
            </div>
        </header>
        <div class="post-body">{{posts.content}}</div>
        <div class="post-actions d-flex flex-wrap justify-content-between gap-2">
            <a href="/" class="btn btn-outline-secondary"><i class="bi bi-list-ul me-1"></i>목록</a>
            <div class="d-flex flex-wrap gap-2">
                {{#user}}
                    <button type="button" id="btn-like" class="btn btn-outline-primary"><i class="bi bi-heart me-1"></i>좋아요</button>
                    <button type="button" id="btn-unlike" class="btn btn-outline-secondary"><i class="bi bi-heartbreak me-1"></i>취소</button>
                {{/user}}
                {{#writer}}
                    <a href="/posts/update/{{posts.id}}" class="btn btn-outline-primary"><i class="bi bi-pencil me-1"></i>수정</a>
                    <button type="button" id="btn-delete" class="btn btn-outline-danger"><i class="bi bi-trash3 me-1"></i>삭제</button>
                {{/writer}}
            </div>
        </div>
    </article>
    <section class="mt-4" aria-labelledby="comments-heading">
        {{>comment/list}}
        {{>comment/form}}
    </section>
</div>
{{>layout/footer}}
